# Eldorado Seller API credentials (Dashboard > Seller API > Generate API client credentials)
ELDORADO_CLIENT_ID=your-client-id
ELDORADO_CLIENT_SECRET=your-client-secret

# Auto-offer on new boosting requests in one category (default: Fortnite 🔥Pirate Shop Access)
AUTO_OFFER=false
OFFER_PRICE=20
OFFER_CURRENCY=USD
OFFER_QUANTITY=1
OFFER_MIN_QUANTITY=1
OFFER_DELIVERY_TIME=Day1        # Minute5 Minute20 Hour1 Hour2 Hour3 Hour5 Hour8 Hour12 Day1 Day2 Day3 ...
OFFER_MESSAGE="your message to the buyer"
OFFER_GAME_ID=16
OFFER_BOOSTING_CATEGORY_ID=6
# OFFER_STATE_FILE=.state/offered.json

# Optional tuning (defaults shown)
# POLL_INTERVAL_MS=1000      # Eldorado documents no rate limit; auto-slows on HTTP 429
# PAGE_SIZE=20               # 1..50 notifications per request
# REQUEST_TIMEOUT_MS=10000
# MAX_CATCHUP_PAGES=5        # extra pages fetched when a whole page is new (bursts)
# MAX_BACKOFF_MS=60000
# STATS_INTERVAL_MS=60000    # terminal [STAT] line; 0 disables
# STATE_FILE=.state/seen.json
# WEB_PORT=3000              # live page at http://127.0.0.1:3000
# WEB_HOST=127.0.0.1         # keep local: the page shows buyer names and order details
# OPEN_BROWSER=true
# ELDORADO_BASE_URL=https://www.eldorado.gg
